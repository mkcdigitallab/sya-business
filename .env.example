APP_NAME="Siya Business"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Contact client (format international sans + ni espaces)
# ── Siya Business ───────────────────────────────────────────
# Téléphone public (format international, sans « + »). Affiché partout sur le site : appel uniquement.
SIYA_PHONE_NUMBER=221781284366
# Facultatifs : ce qui reste vide n'est tout simplement pas affiché.
SIYA_EMAIL=
SIYA_ADDRESS=
SIYA_HOURS=
SIYA_INSTAGRAM=
SIYA_FACEBOOK=
SIYA_TIKTOK=
# Numéro Wave / Orange Money indiqué aux clients pour l'acompte.
SIYA_PAYMENT_NUMBER=
# Acompte demandé à la confirmation d'une commande (en %).
SIYA_DEPOSIT_PERCENT=50
